# ============================================================
# ANKE — змінні оточення
# Скопіюй у .env.local і заповни реальними значеннями.
# Жоден ключ не комітиться в репозиторій.
# ============================================================

# --- Сайт ---
# Фінальний домен (без трейлінг-слеша). Поки домену немає — плейсхолдер.
NEXT_PUBLIC_SITE_URL=https://anke-store.example

# --- Medusa (Етап 3) ---
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=

# --- Нова Пошта (Етап 6) ---
# Ключ з кабінету https://new.novaposhta.ua → Налаштування → Безпека → API-ключі
NOVA_POSHTA_API_KEY=

# --- Mono Acquiring (Етап 6) ---
# Токен з https://web.monobank.ua/ → еквайринг → Інтернет-еквайринг
# Для розробки використовується sandbox-режим без реальних списань
MONO_ACQUIRING_TOKEN=
MONO_WEBHOOK_SECRET=

# --- Checkbox ПРРО (Етап 6) ---
CHECKBOX_LICENSE_KEY=
CHECKBOX_PIN_CODE=

# --- Сповіщення (Етап 6) ---
ADMIN_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# SMTP для транзакційних листів
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Аналітика і PPC (Етап 9) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
